<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>databases</key>
    <array>
        <!-- DEVELOPMENT EXAMPLE (Ditto v5 portal: "Development" mode) -->
        <!-- Required fields: name, mode, databaseId, developmentToken, url -->
        <dict>
            <key>name</key>
            <string>Test Development</string>
            <key>mode</key>
            <string>development</string>
            <key>databaseId</key>
            <string>your-database-id-here</string>
            <key>developmentToken</key>
            <string>your-development-token-here</string>
            <key>url</key>
            <string>https://your-url-here.com</string>
            <key>httpApiUrl</key>
            <string>https://your-http-api-url-here.com</string>
            <key>httpApiKey</key>
            <string>your-http-api-key-here</string>
            <!-- Optional transport settings (defaults to true if not specified) -->
            <key>isBluetoothLeEnabled</key>
            <true/>
            <key>isLanEnabled</key>
            <true/>
            <key>isAwdlEnabled</key>
            <true/>
            <key>isCloudSyncEnabled</key>
            <true/>
            <!-- Optional security settings -->
            <key>allowUntrustedCerts</key>
            <false/>
        </dict>

        <!-- SMALL PEER ONLY EXAMPLE (Ditto v5 portal: "Small Peer Only" mode) -->
        <!-- Required fields: name, mode, databaseId -->
        <!-- url / httpApi fields are not used in small-peer-only mode. -->
        <!-- Provide either an offline developmentToken or a secretKey. -->
        <dict>
            <key>name</key>
            <string>Test Small Peer Only</string>
            <key>mode</key>
            <string>smallPeerOnly</string>
            <key>databaseId</key>
            <string>your-small-peer-database-id-here</string>
            <!-- Offline license token (obtain from https://portal.ditto.live) -->
            <key>developmentToken</key>
            <string></string>
            <!-- OR a 32-character shared secret key -->
            <key>secretKey</key>
            <string></string>
            <!-- Transport settings -->
            <key>isBluetoothLeEnabled</key>
            <true/>
            <key>isLanEnabled</key>
            <true/>
            <key>isAwdlEnabled</key>
            <true/>
            <key>isCloudSyncEnabled</key>
            <false/>
        </dict>

        <!-- Add more database configurations as needed -->
        <!-- You can have multiple databases of the same or different modes -->
    </array>
</dict>
</plist>
