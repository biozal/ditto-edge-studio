<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EdgeStudio.ViewModels"
             xmlns:models="using:EdgeStudio.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="300"
             x:Class="EdgeStudio.Views.StudioView.Inspector.AttachmentViewerView"
             x:DataType="vm:AttachmentViewModel">

    <StackPanel Spacing="8"
                IsVisible="{Binding DetectedAttachments.Count}">

        <TextBlock Text="{Binding DetectedAttachments.Count, StringFormat='Attachments ({0})'}"
                   FontWeight="Bold" Margin="4,8,4,0" />

        <ItemsControl ItemsSource="{Binding DetectedAttachments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AttachmentInfo">
                    <Border Padding="10" Margin="4,4" CornerRadius="6"
                            Background="{DynamicResource SukiBackground}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <!-- Field name -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding FieldName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0" />

                            <!-- Open button — wired in code-behind via Click handler -->
                            <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                    Content="Open"
                                    Click="OnOpenAttachmentClick"
                                    Tag="{Binding}"
                                    VerticalAlignment="Center"
                                    Padding="12,6" />

                            <!-- Metadata row -->
                            <StackPanel Grid.Row="1" Grid.Column="0"
                                        Orientation="Horizontal" Spacing="8"
                                        Margin="0,2,12,0">
                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="Gray" />
                                <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="Gray" />
                                <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="DimGray" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" Width="150" Height="4" />
            <TextBlock Text="{Binding ProgressMessage}" FontSize="11" Foreground="Gray" />
        </StackPanel>
    </StackPanel>
</UserControl>
