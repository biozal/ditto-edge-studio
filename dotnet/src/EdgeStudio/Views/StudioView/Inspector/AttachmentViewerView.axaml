<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EdgeStudio.ViewModels"
             xmlns:models="using:EdgeStudio.Shared.Models"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="300"
             x:Class="EdgeStudio.Views.StudioView.Inspector.AttachmentViewerView"
             x:DataType="vm:AttachmentViewModel">

    <StackPanel Spacing="8"
                IsVisible="{Binding DetectedAttachments.Count}">

        <TextBlock Text="{Binding DetectedAttachments.Count, StringFormat='Attachments ({0})'}"
                   FontWeight="Bold" Margin="4,8,4,0" />

        <ItemsControl ItemsSource="{Binding DetectedAttachments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AttachmentInfo">
                    <Border Padding="10" Margin="4,4" CornerRadius="6"
                            Background="{DynamicResource SukiBackground}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FieldName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                            <Binding Path="FileName" />
                                            <Binding Path="FormattedSize" />
                                            <Binding Path="MimeType" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Open"
                                    Click="OnOpenAttachmentClick"
                                    Tag="{Binding}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Padding="12,6" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" Width="150" Height="4" />
            <TextBlock Text="{Binding ProgressMessage}" FontSize="11" Foreground="Gray" />
        </StackPanel>
    </StackPanel>
</UserControl>
