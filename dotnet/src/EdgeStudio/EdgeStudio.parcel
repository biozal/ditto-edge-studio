{
    "GeneralSettings": {
        "NetProjectPath": "EdgeStudio.csproj",
        "ApplicationName": "Edge Studio",
        "Version": "1.0.0.4",
        "PackageName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        }
    },
    "LinuxSettings": {
        "AppIcon": "Assets/EdgeStudio.ico",
        "Maintainer": "Costoda Coding Monkeys ",
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "InstallerIcon": "Assets/EdgeStudio.ico",
        "Company": "Costoda Coding Monkeys ",
        "InstallerLicense": "../../../LICENSE",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.Costoda-Coding-Monkeys.EdgeStudio",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "ExtraBuildProperties": {}
    }
}