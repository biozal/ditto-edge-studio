<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+; supersedes full-backup-content above
    on those OS versions).

    Identical exclusions for both cloud-backup and device-transfer: the
    SQLCipher key lives in the Android Keystore, which does not travel with
    backups or device transfers, so the encrypted DB must NOT be carried over.

    See plans/android/config-loss-investigation.md (item B2).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ditto_edge_studio.db" />
        <exclude domain="database" path="ditto_edge_studio.db-wal" />
        <exclude domain="database" path="ditto_edge_studio.db-shm" />
        <exclude domain="database" path="ditto_edge_studio.db-journal" />
        <exclude domain="file" path="ditto" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ditto_edge_studio.db" />
        <exclude domain="database" path="ditto_edge_studio.db-wal" />
        <exclude domain="database" path="ditto_edge_studio.db-shm" />
        <exclude domain="database" path="ditto_edge_studio.db-journal" />
        <exclude domain="file" path="ditto" />
    </device-transfer>
</data-extraction-rules>
